# Hindsight profile env  —— 放到 <HINDSIGHT_HOME>/.hindsight/profiles/coding-agent.env
# 这份文件才是 daemon 真正读到的配置（keep-stack3.ps1 里不写密钥，靠它提供）。

# ---- 数据库（关键）----------------------------------------------------------
# 注意：这个键名必须是 HINDSIGHT_EMBED_API_DATABASE_URL。
# embed 启动器会用 get_database_url(profile) 覆写 HINDSIGHT_API_DATABASE_URL，
# 只有 HINDSIGHT_EMBED_API_DATABASE_URL 能盖过它 —— 否则 daemon 会去起自带的
# 嵌入式 PostgreSQL（pg0://…），在受限令牌/沙箱下必然 os error 5。
HINDSIGHT_EMBED_API_DATABASE_URL=postgresql://hindsight:hindsight@127.0.0.1:5433/hindsight
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:hindsight@127.0.0.1:5433/hindsight
HINDSIGHT_API_PORT=9077

# ---- 抽取用 LLM -------------------------------------------------------------
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-chat
HINDSIGHT_API_LLM_BASE_URL=https://api.deepseek.com
# 不要在这里写真实密钥：用环境变量注入
HINDSIGHT_API_LLM_API_KEY=${DEEPSEEK_API_KEY}

# ---- 向量化：DeepSeek 没有 embeddings 端点，只能本地 ONNX --------------------
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_PATH=<HINDSIGHT_HOME>/models/bge-small-en-v1.5/onnx/model.onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_TOKENIZER_NAME_OR_PATH=<HINDSIGHT_HOME>/models/bge-small-en-v1.5

# ---- 重排 -------------------------------------------------------------------
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RERANKER_FLASHRANK_MODEL=ms-marco-MultiBERT-L-12
HINDSIGHT_API_RERANKER_FLASHRANK_CACHE_DIR=<HINDSIGHT_HOME>/flashrank-cache

# ---- 离线/镜像（huggingface.co 不通时）-------------------------------------
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=<HINDSIGHT_HOME>/.cache/huggingface
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS=1
